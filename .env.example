# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fts:fts_password@localhost:5432/fts_dev

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Object Storage (MinIO for dev, S3 for prod) ──────────────────────────────
STORAGE_DRIVER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fts-documents

# AWS S3 (production) — set STORAGE_DRIVER=s3 and fill these
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=fts-documents-prod

# ── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@file-tracking.local

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Documenso e-signature ────────────────────────────────────────────────────
DOCUMENSO_API_URL=http://localhost:3001
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=

# ── OCR Worker ──────────────────────────────────────────────────────────────
OCR_WORKER_URL=http://localhost:8000

# ── Document conversion (LibreOffice engine) ────────────────────────────────
# Optional. When a LibreOffice "soffice" binary is available, the PDF Tools
# module uses it for high-fidelity Office <-> PDF conversion (and unlocks
# Excel/PowerPoint -> PDF). If absent, it falls back to the built-in pure-JS
# engine automatically. Detection order: LIBREOFFICE_PATH -> PATH -> common dirs.
#   Windows example: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux/Docker:    /usr/bin/soffice
# LIBREOFFICE_PATH=/usr/bin/soffice
# Set to "off" to force the pure-JS engine even if LibreOffice is installed.
# LIBREOFFICE_ENGINE=

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
